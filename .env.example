# Copy to .env and adjust. Every value has a working default; this file
# documents the knobs. backend/config.py reads it.

# ---- LLM backend: hf | ollama | openai | fake -----------------------------
# hf    : load finetune/outputs/merged (or outputs/adapter + base model)
# ollama: stream from a local Ollama server (install: https://ollama.com)
# openai: stream from any OpenAI-compatible API (OpenAI, Groq, OpenRouter, etc.)
# fake  : deterministic echo generator (frontend dev / tests, no model)
LLM_BACKEND=fake

# ---- openai / API backend settings ------------------------------------------
# Works with OpenAI, Groq, OpenRouter, DeepSeek, etc.
# Examples:
#   OpenAI:     OPENAI_BASE_URL=https://api.openai.com/v1     OPENAI_MODEL=gpt-4o-mini
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1 OPENAI_MODEL=llama-3.1-8b-instant
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1  OPENAI_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- hf backend settings ----------------------------------------------------
HF_MODEL_DIR=finetune/outputs/merged
HF_ADAPTER_DIR=finetune/outputs/adapter
HF_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# ---- ollama backend settings -----------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# ---- generation -----------------------------------------------------------
MAX_NEW_TOKENS=400
TEMPERATURE=0.7
TOP_P=0.9

# ---- RAG --------------------------------------------------------------------
RAG_INDEX_DIR=rag/index
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.35
RAG_RERANK=false

# ---- API behaviour ---------------------------------------------------------
# Comma-separated allowed origins for the browser frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_S=60
MAX_INPUT_CHARS=4000
HISTORY_TOKEN_BUDGET=1500

# ---- optional: synthetic data generation (finetune/generate_synthetic.py) ----
# SYNTH_BACKEND=local        # or "openai" for an OpenAI-compatible API
# SYNTH_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# SYNTH_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...     # only needed for SYNTH_BACKEND=openai
